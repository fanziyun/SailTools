<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Single source of truth for the product version. installer/build-setup.ps1
         reads <Version> and passes it to Inno Setup as /DMyAppVersion, so the
         artifact name cannot drift from what the app reports about itself. -->
    <Version>1.0.0</Version>
    <!-- Set explicitly rather than via <VersionSuffix>: an explicit <Version>
         overrides the VersionPrefix/VersionSuffix composition, so the suffix would
         be silently dropped. This keeps the settings page reading exactly what it
         read before the refactor ("1.0.0-preview") while the installer artifact
         stays SailTool-Setup-1.0.0-x64.exe. -->
    <InformationalVersion>1.0.0-preview</InformationalVersion>
    <!-- Without this the SDK rewrites InformationalVersion to append +<commit-sha>
         once the project is under git, leaking a hash into the settings page. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>SailTool</RootNamespace>
    <AssemblyName>SailTool</AssemblyName>
    <ApplicationManifest>SailTool.manifest</ApplicationManifest>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture.ToString().ToLowerInvariant())</RuntimeIdentifier>
    <!-- 不打包 .NET 运行时，依赖系统里已安装的 .NET 10 -->
    <SelfContained>false</SelfContained>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <WindowsPackageType>None</WindowsPackageType>
    <EnableMsixTooling>true</EnableMsixTooling>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>14</LangVersion>
    <!-- WinRT AOT optimizer must stay DISABLED. Re-tested on WindowsAppSDK 2.5.1:
         enabling it still breaks the build (60 errors) — the WinRT source generator
         emits WinRTExposedTypeAttribute with 3 args where only fewer exist, mangles
         the "<RootNamespace>VtableClasses" identifier, and then the XAML compiler
         itself dies with WMC9999 (NullReferenceException). -->
    <CsWinRTAotOptimizerEnabled>false</CsWinRTAotOptimizerEnabled>
    <PublishAot>false</PublishAot>
  </PropertyGroup>

  <!-- External tools (adb.exe / fastboot.exe / magiskboot.exe) live in the repo-level
       tools/ directory and are copied to the output as a "platform-tools" subfolder.
       That is exactly where the runtime already looks for them:
       FastbootProcessService.FindToolInPlatformTools -> AppContext.BaseDirectory\platform-tools\
       PatchService.FindMagiskBootPath               -> same folder as fastboot.exe, or the app dir
       so no code has to know where the sources live. Content items would be picked up
       by the WinUI resource indexer, so these are declared as None instead. -->
  <PropertyGroup>
    <ExternalToolsDir>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', '..', '..', 'tools'))</ExternalToolsDir>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(ExternalToolsDir)platform-tools\**\*"
          Link="platform-tools\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\SplashScreen.scale-200.png" />
    <Content Include="Assets\LockScreenLogo.scale-200.png" />
    <Content Include="Assets\Square150x150Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.targetsize-24_altform-unplated.png" />
    <Content Include="Assets\Square44x44Logo.targetsize-48_altform-lightunplated.png" />
    <Content Include="Assets\StoreLogo.png" />
    <Content Include="Assets\AppIcon.ico" />
    <Content Include="Assets\Wide310x150Logo.scale-200.png" />
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <ProjectCapability Include="Msix"/>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2957" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <!-- The test project drives the internal parsing layer
       (Services/Parsing/*, FlashProgressTracker) directly. Those types are
       deliberately internal: they are an implementation detail of the services,
       and keeping them out of the public surface means restructuring them later
       is not a breaking change. -->
  <ItemGroup>
    <InternalsVisibleTo Include="SailTool.Tests" />
  </ItemGroup>

  <PropertyGroup Condition="'$(DisableHasPackageAndPublishMenuAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
  </PropertyGroup>

  <PropertyGroup>
    <!-- ReadyToRun 和 Trimming 仅在自包含模式下生效，框架依赖模式必须关闭 -->
    <PublishReadyToRun>false</PublishReadyToRun>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>
</Project>
