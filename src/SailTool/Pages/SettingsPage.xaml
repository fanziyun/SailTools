<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="FastTool.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="20" Margin="0,0,24,32">

            <!-- Header -->
            <StackPanel Spacing="4">
                <TextBlock Text="设置" Style="{StaticResource TitleTextBlockStyle}" FontSize="20" />
            </StackPanel>

            <!-- Theme switcher card -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    CornerRadius="8" Padding="24">
                <StackPanel Spacing="12">
                    <TextBlock Text="外观" Style="{StaticResource SubtitleTextBlockStyle}" FontSize="16" />

                    <StackPanel Spacing="4">
                        <TextBlock Text="主题模式"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <ComboBox x:Name="ThemeComboBox"
                                  Width="240" HorizontalAlignment="Left"
                                  SelectionChanged="ThemeComboBox_SelectionChanged">
                            <ComboBoxItem Content="跟随系统" Tag="Default" IsSelected="True" />
                            <ComboBoxItem Content="浅色" Tag="Light" />
                            <ComboBoxItem Content="深色" Tag="Dark" />
                        </ComboBox>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- App info card -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    CornerRadius="8" Padding="24">
                <StackPanel Spacing="12">
                    <TextBlock Text="关于" Style="{StaticResource SubtitleTextBlockStyle}" FontSize="16" />

                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto"
                          RowSpacing="8" ColumnSpacing="16">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="版本"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Row="0" Grid.Column="1"
                                   Text="{x:Bind ViewModel.AppVersion}"
                                   Style="{StaticResource BodyStrongTextBlockStyle}" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="运行时"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Row="1" Grid.Column="1"
                                   Text=".NET 10 / WinUI 3 (Windows App SDK)"
                                   Style="{StaticResource BodyStrongTextBlockStyle}" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="运行模式"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind ViewModel.DeployMode}"
                                   Style="{StaticResource BodyStrongTextBlockStyle}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Open source license card -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    CornerRadius="8" Padding="24">
                <StackPanel Spacing="14">
                    <TextBlock Text="开源许可" Style="{StaticResource SubtitleTextBlockStyle}" FontSize="16" />

                    <!-- .NET -->
                    <StackPanel Spacing="2">
                        <TextBlock Text=".NET" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock Text="MIT License — © .NET Foundation and Contributors"
                                   FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <HyperlinkButton Content="https://github.com/dotnet/runtime"
                                         NavigateUri="https://github.com/dotnet/runtime/blob/main/LICENSE.TXT"
                                         FontSize="12" Padding="0,2" />
                    </StackPanel>

                    <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                    <!-- Windows App SDK (WinUI 3) -->
                    <StackPanel Spacing="2">
                        <TextBlock Text="Windows App SDK (WinUI 3)" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock Text="MIT License — © Microsoft Corporation"
                                   FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <HyperlinkButton Content="https://github.com/microsoft/microsoft-ui-xaml"
                                         NavigateUri="https://github.com/microsoft/microsoft-ui-xaml/blob/main/LICENSE"
                                         FontSize="12" Padding="0,2" />
                    </StackPanel>

                    <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                    <!-- CommunityToolkit.Mvvm -->
                    <StackPanel Spacing="2">
                        <TextBlock Text="CommunityToolkit.Mvvm" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock Text="MIT License — © .NET Foundation"
                                   FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <HyperlinkButton Content="https://github.com/CommunityToolkit/dotnet"
                                         NavigateUri="https://github.com/CommunityToolkit/dotnet/blob/main/LICENSE.TXT"
                                         FontSize="12" Padding="0,2" />
                    </StackPanel>

                    <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                    <!-- Android SDK Platform Tools (fastboot/adb) -->
                    <StackPanel Spacing="2">
                        <TextBlock Text="Android SDK Platform Tools (fastboot / adb)" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock Text="Apache License 2.0 — © Google LLC"
                                   FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <HyperlinkButton Content="https://developer.android.com/tools/releases/platform-tools"
                                         NavigateUri="https://developer.android.com/tools/releases/platform-tools"
                                         FontSize="12" Padding="0,2" />
                    </StackPanel>

                    <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                    <!-- Windows SDK Build Tools -->
                    <StackPanel Spacing="2">
                        <TextBlock Text="Windows SDK Build Tools" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock Text="MIT License — © Microsoft Corporation"
                                   FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <HyperlinkButton Content="https://developer.microsoft.com/en-us/windows/downloads/windows-sdk/"
                                         NavigateUri="https://developer.microsoft.com/en-us/windows/downloads/windows-sdk/"
                                         FontSize="12" Padding="0,2" />
                    </StackPanel>

                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
