<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="SailTool.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="20"
                    Margin="0,0,24,32">

            <!-- Page Header (left-aligned) -->
            <StackPanel Spacing="2">
                <TextBlock Text="363FastTool"
                           Style="{StaticResource TitleTextBlockStyle}"
                           FontSize="22"
                           HorizontalAlignment="Left" />
                <TextBlock Text="现代化安卓刷机工具箱 — 支持 ADB / Fastboot"
                           Style="{StaticResource BodyTextBlockStyle}"
                           FontSize="13"
                           HorizontalAlignment="Left"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <!-- Device Detect Card -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    CornerRadius="8"
                    Padding="20,18"
                    Margin="0,4,0,0">
                <StackPanel Spacing="14">

                    <!-- Card title -->
                    <TextBlock Text="设备检测"
                               Style="{StaticResource SubtitleTextBlockStyle}"
                               FontSize="14" />

                    <!-- Status row: indicator dot + primary status text -->
                    <StackPanel Orientation="Horizontal" Spacing="14">

                        <!-- Indicator dot -->
                        <Grid Width="44" Height="44"
                              CornerRadius="22"
                              VerticalAlignment="Center">
                            <Grid.Background>
                                <SolidColorBrush x:Name="IndicatorBg"
                                                 Color="#30FF5252" />
                            </Grid.Background>

                            <!-- Connected: green (Fastboot) or blue (ADB) -->
                            <Ellipse x:Name="ConnectedDot"
                                     Width="16" Height="16"
                                     Visibility="Collapsed">
                                <Ellipse.Fill>
                                    <SolidColorBrush x:Name="ConnectedFill"
                                                     Color="#4CAF50" />
                                </Ellipse.Fill>
                            </Ellipse>

                            <!-- Disconnected: red -->
                            <Ellipse x:Name="DisconnDot"
                                     Width="16" Height="16"
                                     Visibility="Visible">
                                <Ellipse.Fill>
                                    <SolidColorBrush Color="#FF5252" />
                                </Ellipse.Fill>
                            </Ellipse>
                        </Grid>

                        <StackPanel VerticalAlignment="Center" Spacing="2">
                            <TextBlock x:Name="PrimaryStatusLabel"
                                       Text="未连接"
                                       Style="{StaticResource BodyStrongTextBlockStyle}"
                                       FontSize="16" />
                            <TextBlock x:Name="SecondaryStatusLabel"
                                       Text="等待设备连接，将自动检测"
                                       FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Divider 1 -->
                    <Border Height="1" Margin="0,2"
                            Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                    <!-- Device info grid: 3 columns x 3 rows -->
                    <Grid ColumnDefinitions="*,*,*"
                          ColumnSpacing="24"
                          RowDefinitions="Auto,Auto,Auto,Auto"
                          RowSpacing="6">

                        <!-- Row 0 -->
                        <TextBlock Grid.Row="0" Grid.Column="0"
                                   Text="检测方式" FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Row="1" Grid.Column="0"
                                   Text="{x:Bind DisplayField(ViewModel.CurrentDetailedDevice, 'ConnectionType'), Mode=OneWay}"
                                   Style="{StaticResource BodyStrongTextBlockStyle}" />

                        <TextBlock Grid.Row="0" Grid.Column="1"
                                   Text="设备代号" FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Row="1" Grid.Column="1"
                                   Text="{x:Bind DisplayField(ViewModel.CurrentDetailedDevice, 'DeviceCodename'), Mode=OneWay}"
                                   Style="{StaticResource BodyStrongTextBlockStyle}" />

                        <TextBlock Grid.Row="0" Grid.Column="2"
                                   Text="品牌" FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Row="1" Grid.Column="2"
                                   Text="{x:Bind DisplayField(ViewModel.CurrentDetailedDevice, 'Brand'), Mode=OneWay}"
                                   Style="{StaticResource BodyStrongTextBlockStyle}" />

                        <!-- Row 2 -->
                        <TextBlock Grid.Row="2" Grid.Column="0"
                                   Text="BL 状态" FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Row="3" Grid.Column="0"
                                   Text="{x:Bind DisplayField(ViewModel.CurrentDetailedDevice, 'BootloaderStatus'), Mode=OneWay}"
                                   Style="{StaticResource BodyStrongTextBlockStyle}" />

                        <TextBlock Grid.Row="2" Grid.Column="1"
                                   Text="A/B 槽位" FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Row="3" Grid.Column="1"
                                   Text="{x:Bind DisplayField(ViewModel.CurrentDetailedDevice, 'Slot'), Mode=OneWay}"
                                   Style="{StaticResource BodyStrongTextBlockStyle}" />

                        <TextBlock Grid.Row="2" Grid.Column="2"
                                   Text="型号" FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Row="3" Grid.Column="2"
                                   Text="{x:Bind DisplayField(ViewModel.CurrentDetailedDevice, 'Model'), Mode=OneWay}"
                                   Style="{StaticResource BodyStrongTextBlockStyle}" />
                    </Grid>

                    <!-- Second info grid: system version / kernel -->
                    <Grid ColumnDefinitions="*,*,*"
                          ColumnSpacing="24"
                          RowDefinitions="Auto,Auto"
                          RowSpacing="6"
                          Margin="0,6,0,0">

                        <TextBlock Grid.Row="0" Grid.Column="0"
                                   Text="安卓版本" FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Row="1" Grid.Column="0"
                                   Text="{x:Bind DisplayField(ViewModel.CurrentDetailedDevice, 'AndroidVersion'), Mode=OneWay}"
                                   Style="{StaticResource BodyStrongTextBlockStyle}" />

                        <TextBlock Grid.Row="0" Grid.Column="1"
                                   Text="系统版本" FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Row="1" Grid.Column="1"
                                   Text="{x:Bind DisplayField(ViewModel.CurrentDetailedDevice, 'SystemVersion'), Mode=OneWay}"
                                   Style="{StaticResource BodyStrongTextBlockStyle}" />

                        <TextBlock Grid.Row="0" Grid.Column="2"
                                   Text="内核版本" FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Row="1" Grid.Column="2"
                                   Text="{x:Bind DisplayField(ViewModel.CurrentDetailedDevice, 'KernelVersion'), Mode=OneWay}"
                                   Style="{StaticResource BodyStrongTextBlockStyle}" />
                    </Grid>

                    <!-- Divider 2 -->
                    <Border Height="1" Margin="0,2"
                            Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                    <!-- Detect button -->
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="DetectBtn" Click="DetectButton_Click"
                                Style="{StaticResource AccentButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon FontFamily="Segoe Fluent Icons"
                                          Glyph="&#xE72C;" FontSize="13" />
                                <TextBlock Text="立即检测" FontSize="13" />
                            </StackPanel>
                        </Button>
                        <ProgressRing x:Name="LoadingRing"
                                      IsActive="False"
                                      Width="24" Height="24" />
                        <TextBlock x:Name="ErrorLabel"
                                   Foreground="#FF5252"
                                   VerticalAlignment="Center"
                                   FontSize="12" />
                    </StackPanel>

                </StackPanel>
            </Border>

            <!-- 三列卡片布局 -->
            <Grid x:Name="CardsGrid" 
                  ColumnDefinitions="*,*,*" 
                  ColumnSpacing="16">
                
                <!-- 第1列：已检测设备卡片 -->
                <Border Grid.Column="0"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        CornerRadius="8"
                        Padding="20,16">
                    <StackPanel Spacing="12">
                        <TextBlock Text="已检测设备"
                                   Style="{StaticResource SubtitleTextBlockStyle}"
                                   FontSize="13" />

                        <!-- 标准 WinUI 3 ComboBox -->
                        <ComboBox x:Name="DeviceComboBox"
                                  Header="设备列表"
                                  PlaceholderText="未检测到设备"
                                  HorizontalAlignment="Stretch"
                                  ItemsSource="{x:Bind ViewModel.Devices, Mode=OneWay}"
                                  SelectedItem="{x:Bind ViewModel.SelectedDevice, Mode=TwoWay}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="models:DeviceInfo"
                                              xmlns:models="using:SailTool.Models">
                                    <StackPanel Spacing="2" Padding="0,2">
                                        <TextBlock Text="{x:Bind DisplayName}"
                                                   Style="{StaticResource BodyStrongTextBlockStyle}"
                                                   FontSize="13"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind ConnectionType}"
                                                   FontSize="11"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                </Border>

                <!-- 第2列：驱动补丁卡片 -->
                <Border Grid.Column="1"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        CornerRadius="8"
                        Padding="20,16">
                    <StackPanel Spacing="10">
                        <TextBlock Text="驱动补丁"
                                   Style="{StaticResource SubtitleTextBlockStyle}"
                                   FontSize="13" />
                        <TextBlock Text="USB 驱动安装"
                                   FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Button Content="安装 ADB 和 Fastboot 驱动"
                                Click="InstallDriver_Click" />
                    </StackPanel>
                </Border>

                <!-- 第3列：快速重启卡片 -->
                <Border Grid.Column="2"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        CornerRadius="8"
                        Padding="20,16">
                    <StackPanel Spacing="12">
                        <TextBlock Text="快速重启"
                                   Style="{StaticResource SubtitleTextBlockStyle}"
                                   FontSize="13" />
                        <TextBlock Text="重启设备到指定模式"
                                   FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                        <!-- 2行 x 3列按钮网格 -->
                        <Grid ColumnDefinitions="*,*,*"
                              RowDefinitions="Auto,Auto"
                              ColumnSpacing="8"
                              RowSpacing="8">

                            <!-- 第1行 -->
                            <Button Grid.Row="0" Grid.Column="0"
                                    Content="系统" Tag="system"
                                    HorizontalAlignment="Stretch"
                                    Padding="8,10"
                                    Click="QuickReboot_Click" />
                            <Button Grid.Row="0" Grid.Column="1"
                                    Content="Recovery" Tag="recovery"
                                    HorizontalAlignment="Stretch"
                                    Padding="8,10"
                                    Click="QuickReboot_Click" />
                            <Button Grid.Row="0" Grid.Column="2"
                                    Content="Bootloader" Tag="bootloader"
                                    HorizontalAlignment="Stretch"
                                    Padding="8,10"
                                    Click="QuickReboot_Click" />

                            <!-- 第2行 -->
                            <Button Grid.Row="1" Grid.Column="0"
                                    Content="Fastbootd" Tag="fastbootd"
                                    HorizontalAlignment="Stretch"
                                    Padding="8,10"
                                    Click="QuickReboot_Click" />
                            <Button Grid.Row="1" Grid.Column="1"
                                    Content="关机" Tag="shutdown"
                                    HorizontalAlignment="Stretch"
                                    Padding="8,10"
                                    Click="QuickReboot_Click" />
                            <Button Grid.Row="1" Grid.Column="2"
                                    Content="9008" Tag="edl"
                                    HorizontalAlignment="Stretch"
                                    Padding="8,10"
                                    Click="QuickReboot_Click" />
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</Page>
