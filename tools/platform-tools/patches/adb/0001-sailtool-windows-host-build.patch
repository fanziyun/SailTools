diff --git a/lib/windows/usb/compat/atl_compat.h b/lib/windows/usb/compat/atl_compat.h
new file mode 100644
index 0000000..2ed841b
--- /dev/null
+++ b/lib/windows/usb/compat/atl_compat.h
@@ -0,0 +1,34 @@
+#pragma once
+/* Minimal ATL replacement: the AOSP sources use exactly one ATL class
+ * (CComAutoCriticalSection) plus CComCritSecLock.  Both map directly onto the
+ * Win32 critical section. */
+#include <windows.h>
+#include <assert.h>
+#ifndef ATLASSERT
+#define ATLASSERT(x) assert(x)
+#endif
+template <class T> class CAtlDllModuleT {
+public:
+    BOOL DllMain(DWORD, LPVOID) { return TRUE; }
+};
+class CComAutoCriticalSection {
+public:
+    CComAutoCriticalSection()  { ::InitializeCriticalSection(&cs_); }
+    ~CComAutoCriticalSection() { ::DeleteCriticalSection(&cs_); }
+    void Lock()   { ::EnterCriticalSection(&cs_); }
+    void Unlock() { ::LeaveCriticalSection(&cs_); }
+private:
+    CRITICAL_SECTION cs_;
+    CComAutoCriticalSection(const CComAutoCriticalSection&);
+    CComAutoCriticalSection& operator=(const CComAutoCriticalSection&);
+};
+template <class T>
+class CComCritSecLock {
+public:
+    explicit CComCritSecLock(T& cs) : cs_(cs) { cs_.Lock(); }
+    ~CComCritSecLock() { cs_.Unlock(); }
+private:
+    T& cs_;
+    CComCritSecLock(const CComCritSecLock&);
+    CComCritSecLock& operator=(const CComCritSecLock&);
+};
diff --git a/lib/windows/usb/compat/usb100.h b/lib/windows/usb/compat/usb100.h
new file mode 100644
index 0000000..b2bbd91
--- /dev/null
+++ b/lib/windows/usb/compat/usb100.h
@@ -0,0 +1,52 @@
+#pragma once
+/* Minimal WDK usb100.h subset for MinGW.  Only the descriptor layouts the
+ * AOSP AdbWinApi sources use; both are fixed by the USB 2.0 spec. */
+#include <windows.h>
+#include <pshpack1.h>
+typedef struct _USB_DEVICE_DESCRIPTOR {
+    UCHAR  bLength;
+    UCHAR  bDescriptorType;
+    USHORT bcdUSB;
+    UCHAR  bDeviceClass;
+    UCHAR  bDeviceSubClass;
+    UCHAR  bDeviceProtocol;
+    UCHAR  bMaxPacketSize0;
+    USHORT idVendor;
+    USHORT idProduct;
+    USHORT bcdDevice;
+    UCHAR  iManufacturer;
+    UCHAR  iProduct;
+    UCHAR  iSerialNumber;
+    UCHAR  bNumConfigurations;
+} USB_DEVICE_DESCRIPTOR, *PUSB_DEVICE_DESCRIPTOR;
+typedef struct _USB_CONFIGURATION_DESCRIPTOR {
+    UCHAR  bLength;
+    UCHAR  bDescriptorType;
+    USHORT wTotalLength;
+    UCHAR  bNumInterfaces;
+    UCHAR  bConfigurationValue;
+    UCHAR  iConfiguration;
+    UCHAR  bmAttributes;
+    UCHAR  MaxPower;
+} USB_CONFIGURATION_DESCRIPTOR, *PUSB_CONFIGURATION_DESCRIPTOR;
+typedef struct _USB_INTERFACE_DESCRIPTOR {
+    UCHAR bLength;
+    UCHAR bDescriptorType;
+    UCHAR bInterfaceNumber;
+    UCHAR bAlternateSetting;
+    UCHAR bNumEndpoints;
+    UCHAR bInterfaceClass;
+    UCHAR bInterfaceSubClass;
+    UCHAR bInterfaceProtocol;
+    UCHAR iInterface;
+} USB_INTERFACE_DESCRIPTOR, *PUSB_INTERFACE_DESCRIPTOR;
+#include <poppack.h>
+#define USB_ENDPOINT_DIRECTION_MASK 0x80
+#define USB_DEVICE_DESCRIPTOR_TYPE          0x01
+#define USB_CONFIGURATION_DESCRIPTOR_TYPE   0x02
+#define USB_STRING_DESCRIPTOR_TYPE          0x03
+typedef struct _USB_STRING_DESCRIPTOR {
+    UCHAR bLength;
+    UCHAR bDescriptorType;
+    WCHAR bString[1];
+} USB_STRING_DESCRIPTOR, *PUSB_STRING_DESCRIPTOR;
